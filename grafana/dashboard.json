{
  "title": "nav-etterlevelse-mcp",
  "tags": [
    "dab",
    "nav-etterlevelse-mcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datakilde",
        "description": "Velg Prometheus-datakilden for miljøet (dev-gcp eller prod-gcp)",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": [],
          "value": []
        },
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "description": "Velg Kubernetes-namespace",
        "options": [
          {
            "text": "dab",
            "value": "dab"
          }
        ],
        "current": {
          "selected": true,
          "text": "dab",
          "value": "dab"
        },
        "query": "dab",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Aktive sesjoner",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(mcp_active_sessions{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"})",
          "legendFormat": "Aktive sesjoner",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 2,
      "title": "Auth refresh siste 24t",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(auth_refreshes_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "Refresh",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 3,
      "title": "Feilrate siste time",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(mcp_errors_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h])) / sum(rate(mcp_requests_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h])) * 100",
          "legendFormat": "Feilrate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 4,
      "title": "OBO-feil siste 24t",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(texas_obo_errors_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "OBO-feil",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 5,
      "title": "Kall per tool siste time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_requests_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "ops/s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 6,
      "title": "Responstid p50/p95/p99 per tool",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h])))",
          "legendFormat": "p99 {{tool}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          },
          "unit": "s",
          "decimals": 2
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 7,
      "title": "Etterlevelse-skriv per krav og status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kravnummer, suksesskriterium_status) (increase(etterlevelse_writes_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "K{{kravnummer}} — {{suksesskriterium_status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "description": "Antall skriveoperasjoner per kravnummer og SK-status siste 24 timer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 8,
      "title": "PVK-operasjoner",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (operation, status) (increase(pvk_operations_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "{{operation}} — {{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "description": "Risikoscenarioer og tiltak opprettet/oppdatert siste 24 timer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 9,
      "title": "Navet-bruk per fagområde",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (fagomrade) (increase(navet_reads_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "{{fagomrade}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 10,
      "title": "Feil per tool og feiltype",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (tool, error_type) (increase(mcp_errors_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "{{tool}} — {{error_type}}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 11,
      "title": "SK-gjennomgang: startet og skrevet per time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "description": "Antall begin_sk_review og vellykkede write_suksesskriterium i glidende timevinduer. Avbrutte gjennomganger og nye forsøk på skriving kan gi forskjell. Tallene bekrefter ikke at brukeren har godkjent.",
      "targets": [
        {
          "expr": "sum(increase(sk_review_begin_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[1h]))",
          "legendFormat": "startet",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(increase(sk_review_write_outcome_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\", outcome=\"accepted\"}[1h]))",
          "legendFormat": "skrevet",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 12,
      "title": "SK-skriving: utfall siste 24 timer",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "description": "Avvisninger per outcome og vellykkede skrivinger per klientoppgitt bruker_godkjenning (G/R). G/R er ikke en uavhengig bekreftelse fra brukeren.",
      "targets": [
        {
          "expr": "sum by (outcome, bruker_godkjenning) (increase(sk_review_write_outcome_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[24h]))",
          "legendFormat": "{{outcome}} / {{bruker_godkjenning}}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 13,
      "title": "Avviste SK-tokenforsøk per time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "description": "Avviste skriveforsøk per outcome i glidende timevinduer. Dev-varselet teller mismatched_sk og invalid_token samlet (minst 10 siste time i 10 minutter). Avvisninger alene beviser ikke batching.",
      "targets": [
        {
          "expr": "sum by (outcome) (increase(sk_review_write_outcome_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\", outcome!=\"accepted\"}[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 14,
      "title": "Skriving: nye vs. reviderte SK-svar per krav (7d)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "description": "write_type=revised betyr at suksesskriteriet allerede hadde en begrunnelse. Høy andel revised på et krav er en proxy for at kravet er vanskelig/tiltrekker mest iterasjon.",
      "targets": [
        {
          "expr": "sum by (kravnummer, write_type) (increase(etterlevelse_writes_total{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d]))",
          "legendFormat": "K{{kravnummer}} — {{write_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 15,
      "title": "Krav per arbeidsøkt (7d)",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "description": "Hvor mange ulike krav som får minst én godkjent SK-skriving eller krav-status i én økt. Én arbeidsøkt er én bruker som jobber med ett dokument, fram til dokumentbytte eller 60 minutter uten aktivitet. Ny låsing av samme dokument fortsetter økta.",
      "targets": [
        {
          "expr": "sum by (le) (increase(etterlevelse_work_session_krav_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d]))",
          "legendFormat": "≤ {{le}}",
          "refId": "A",
          "format": "heatmap",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 16,
      "title": "Suksesskriterier per arbeidsøkt (7d)",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "description": "Hvor mange ulike suksesskriterier som skrives (G/R) i én økt. Skriving skjer ett SK om gangen, så dette er målet for hvor mye man dokumenterer i én runde. Én arbeidsøkt er én bruker som jobber med ett dokument, fram til dokumentbytte eller 60 minutter uten aktivitet. Ny låsing av samme dokument fortsetter økta.",
      "targets": [
        {
          "expr": "sum by (le) (increase(etterlevelse_work_session_suksesskriterier_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d]))",
          "legendFormat": "≤ {{le}}",
          "refId": "A",
          "format": "heatmap",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 17,
      "title": "Arbeidsøkter: antall og median per avslutningsårsak (7d)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 6
      },
      "description": "inaktiv = 60 minutter uten aktivitet, dokumentbytte = brukeren låste et annet dokument. Én arbeidsøkt er én bruker som jobber med ett dokument, fram til dokumentbytte eller 60 minutter uten aktivitet. Ny låsing av samme dokument fortsetter økta.",
      "targets": [
        {
          "expr": "sum by (end_reason) (increase(etterlevelse_work_session_krav_count{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d]))",
          "legendFormat": "Økter",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le, end_reason) (increase(etterlevelse_work_session_krav_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d])))",
          "legendFormat": "Median krav",
          "refId": "B",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le, end_reason) (increase(etterlevelse_work_session_suksesskriterier_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d])))",
          "legendFormat": "Median SK",
          "refId": "C",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le, end_reason) (increase(etterlevelse_work_session_duration_seconds_bucket{namespace=\"$namespace\", app=\"nav-etterlevelse-mcp\"}[7d])))",
          "legendFormat": "Median varighet",
          "refId": "D",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "end_reason": "Avslutning",
              "Value #A": "Økter",
              "Value #B": "Median krav",
              "Value #C": "Median SK",
              "Value #D": "Median varighet"
