{
  "dashboard": {
    "title": "nav-etterlevelse-mcp",
    "uid": "nav-etterlevelse-mcp",
    "tags": ["dab", "nav-etterlevelse-mcp"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Aktive sesjoner",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "mcp_active_sessions{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}",
            "legendFormat": "Aktive sesjoner",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "Auth refresh siste 24t",
        "type": "stat",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(increase(auth_refreshes_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "Refresh",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0 }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "Feilrate siste time",
        "type": "stat",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(mcp_errors_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h])) / sum(rate(mcp_requests_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h])) * 100",
            "legendFormat": "Feilrate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            },
            "unit": "percent",
            "decimals": 1
          }
        }
      },
      {
        "id": 4,
        "title": "OBO-feil siste 24t",
        "type": "stat",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(increase(texas_obo_errors_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "OBO-feil",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 5,
        "title": "Kall per tool siste time",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (tool) (rate(mcp_requests_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h]))",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            },
            "unit": "ops/s"
          }
        }
      },
      {
        "id": 6,
        "title": "Responstid p50/p95/p99 per tool",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h])))",
            "legendFormat": "p50 {{tool}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h])))",
            "legendFormat": "p95 {{tool}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le, tool) (rate(mcp_request_duration_seconds_bucket{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[1h])))",
            "legendFormat": "p99 {{tool}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 5
            },
            "unit": "s",
            "decimals": 2
          }
        }
      },
      {
        "id": 7,
        "title": "Etterlevelse-skriv per krav og status",
        "type": "bar",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (kravnummer, suksesskriterium_status) (increase(etterlevelse_writes_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "K{{kravnummer}} — {{suksesskriterium_status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          }
        },
        "description": "Antall skriveoperasjoner per kravnummer og SK-status siste 24 timer"
      },
      {
        "id": 8,
        "title": "PVK-operasjoner",
        "type": "bar",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (operation, status) (increase(pvk_operations_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "{{operation}} — {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          }
        },
        "description": "Risikoscenarioer og tiltak opprettet/oppdatert siste 24 timer"
      },
      {
        "id": 9,
        "title": "Navet-bruk per fagområde",
        "type": "bar",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum by (fagomrade) (increase(navet_reads_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "{{fagomrade}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "unit": "short"
          }
        }
      },
      {
        "id": 10,
        "title": "Feil per tool og feiltype",
        "type": "table",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum by (tool, error_type) (increase(mcp_errors_total{namespace=\"dab\", app=\"nav-etterlevelse-mcp\"}[24h]))",
            "legendFormat": "{{tool}} — {{error_type}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          }
        }
      }
    ]
  }
}
